{
  "name": "pinequest-ai-patient",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "cases:validate": "tsx scripts/validate-cases.ts",
    "schema:export": "tsx scripts/export-json-schema.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "ml:fixtures": "tsx --conditions=react-server scripts/export-prompt-fixtures.ts"
  },
  "dependencies": {
    "@anam-ai/js-sdk": "4.27.1",
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.60.0",
    "motion": "^14.5.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "simli-client": "3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "AI patient simulator for Mongolian medical students (history-taking & diagnostic reasoning)",
  "engines": {
    "node": ">=20.9"
  }
}
