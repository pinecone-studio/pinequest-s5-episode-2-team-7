# ---------------------------------------------------------------------------
# PineQuest AI Patient — environment template
# Copy to `.env` for local development:   cp .env.example .env
# Never commit real values. All of these are SERVER-SIDE ONLY (no NEXT_PUBLIC_).
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
# Public base URL of the deployed app (used for absolute links / cookies).
APP_URL=http://localhost:3000

# Secret used to encrypt the session cookie. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# --- Database --------------------------------------------------------------
# PostgreSQL connection string (Neon free tier recommended, use the *pooled* URL
# with ?sslmode=verify-full). Leave EMPTY for local development to use an embedded
# PGlite database stored in ./.data/pglite (no install required).
# Production (Vercel) REQUIRES a real DATABASE_URL.
DATABASE_URL=

# --- First administrator (used only by `npm run db:seed`) ------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Optional demo student account created by the seed script.
SEED_STUDENT_EMAIL=student@example.com
SEED_STUDENT_PASSWORD=

# --- Patient AI provider ---------------------------------------------------
# Which provider writes the patient's natural-language answers:
#   mock               deterministic templates, no network, no key (default)
#   gemini             Google Gemini API (free tier available)
#   anthropic          Anthropic Claude API (paid)
#   openai_compatible  any OpenAI-compatible server (Ollama, vLLM, LM Studio, OpenRouter...)
#   finetuned          our own fine-tuned model behind the inference service
PATIENT_PROVIDER=mock

# What to do if the configured provider fails: `mock` (answer from templates and
# record that a fallback was used) or `none` (show an error to the student).
PATIENT_FALLBACK_PROVIDER=mock

# Question understanding: `keyword` (deterministic Mongolian lexicon only) or
# `hybrid` (lexicon first, then the LLM picks a topic label when no keyword
# matches; the LLM never sees the hidden case for this step).
INTENT_CLASSIFIER=keyword

# Optional LLM-written narrative paragraph on the feedback page. Scores are
# always computed deterministically; this only adds prose. `off` or `llm`.
FEEDBACK_NARRATIVE=off

# Google Gemini (https://aistudio.google.com/apikey). Check AI Studio for the
# current free-tier model names.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude (https://console.anthropic.com) — paid, prepaid credits.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Generic OpenAI-compatible endpoint (e.g. Ollama: http://localhost:11434/v1).
# Free and fast: Groq (https://console.groq.com) with
#   OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1  OPENAI_COMPAT_MODEL=qwen/qwen3.8-27b
# (free tier: 8,000 tokens/min ≈ one interview at a time; extra load falls back to templates).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Our fine-tuned model served by ./inference (or vLLM with the LoRA adapter).
FINETUNED_BASE_URL=
FINETUNED_API_KEY=
FINETUNED_MODEL=pinequest-patient
# The adapter id the app expects the inference service to report on /health.
# If it does not match, the app refuses to label answers as "fine-tuned".
FINETUNED_EXPECTED_ADAPTER=

# Per-user limit for patient questions.
RATE_LIMIT_MESSAGES_PER_MINUTE=20
